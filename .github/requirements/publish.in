# What the publish job installs; publish.txt is generated from this file (the command is in publish.yml).
# The job holds the PyPI token: build makes the distributions and twine uploads them. Its version bump
# uses only the standard library.
build
twine
# The build backend. The job runs `python -m build --no-isolation`, so the backend is this locked one
# and not whatever is newest on PyPI when the job runs. It must satisfy `build-system.requires` in
# pyproject.toml.
setuptools
